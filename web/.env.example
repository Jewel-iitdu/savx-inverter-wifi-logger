# VITE_FIREBASE_API_KEY is the BROWSER key (HTTP-referrer restricted, research/r7-web-hosting.md §6.2).
# For `npm run dev` on localhost or the LAN, put the DEVICE key in web/.env.local instead (no referrer needed).
# CI does not read this file: deploy-web.yml takes the values from GitHub repository Variables.
#
# Copy to web/.env and fill in from Firebase console -> Project settings -> Your apps -> Web app (SDK setup and configuration).
# These values are NOT secrets (they ship inside the PWA), but keep .env out of git anyway so forks do not point at your project.
# Security comes from the UID-pinned database rules (firebase/database.rules.json), not from hiding these values.
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Realtime Database in Singapore. Copy the exact URL shown at the top of the Realtime Database -> Data tab.
# It must be an *.asia-southeast1.firebasedatabase.app URL: the Content-Security-Policy (web/public/_headers) allows only that region.
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
# Device node under /devices/. Must match the firmware and the rules (d1 uses "inv1").
VITE_DEVICE_ID=inv1
