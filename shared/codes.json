{
  "version": 1,
  "about": "Single source of truth for mode letters, status bits, warning/fault code tables and event types. tools/gen_codes.py turns it into web/src/codes.ts (and the firmware agents may generate firmware/include/codes.h from the same file). LCD codes, QPIWS bits and REVO QALL codes use DIFFERENT numbering (d1 K13, v1 C13): always decode a code with the table named by its source tag.",
  "sources": {
    "manual": "Savx F4 paper manual v3.0, section 5 'Fault Reference Code' and section 6 'Warning Indicator' (printed pages 27-28; reference/Savx-F4-user-manual.pdf page 15). [CONFIRMED-primary]",
    "p2014": "Voltronic 'Infini/Axpert' PI30 protocol P2014 (HS/MS/MSX), QPIWS a0..a31 and fault-code table. Via research/r2-voltronic-pi30.md section 5.6. [CONFIRMED-primary]",
    "p2015": "Voltronic PI30 P2015 (Plus Duo), QPIWS b1..b38 (b1 = a0). Via r2 section 5.6. [CONFIRMED-primary]",
    "pmax": "Voltronic PI30MAX (2021-02-17), QPIWS a0..a35; 24 V model fault code in a31..a32. Via r2 section 5.6 and v1 V19. [CONFIRMED-primary]",
    "pgk": "Voltronic PIP-GK/MK, QPIWS a0..a35, fault code in a31..a32, extra QMOD letters. Via r2 section 5.6. [CONFIRMED-primary]",
    "revo": "Sorotec 'Revo RS232 Communication Protocol V02' (2020-11-12), QALL warning code table 00-07/21-26 and fault code table 01-12 (Google-translated original wording kept). Via v1 C12/C13. [CONFIRMED-primary]",
    "mppsolar": "jblance/mpp-solar pi30revo.py additions (warning 08, 39). NOT in the Sorotec document. [SECONDARY]"
  },

  "qmod": [
    { "code": "P", "name": "Power on", "short": "Power-on", "docs": "P2014, PMAX, PGK" },
    { "code": "S", "name": "Standby", "short": "Standby", "docs": "all" },
    { "code": "L", "name": "Line (grid) mode", "short": "Line", "docs": "all" },
    { "code": "B", "name": "Battery (inverter) mode", "short": "Battery", "docs": "all" },
    { "code": "F", "name": "Fault", "short": "Fault", "docs": "all" },
    { "code": "H", "name": "Power saving (REVO: sleep)", "short": "Saving", "docs": "P2014, P2015, PGK; REVO calls it Sleep" },
    { "code": "D", "name": "Shutdown", "short": "Shutdown", "docs": "PMAX, PGK" },
    { "code": "C", "name": "Charge mode", "short": "Charge", "docs": "PGK" },
    { "code": "Y", "name": "Bypass", "short": "Bypass", "docs": "PGK (PIP-MK)" },
    { "code": "E", "name": "ECO mode", "short": "ECO", "docs": "PGK (PIP-MK)" }
  ],

  "statusBits": {
    "about": "QPIGS field 16 is 8 chars 'b7b6b5b4b3b2b1b0' (first char = b7). QPIGS field 20 is 3 chars 'b10b9b8'. Index = character position in the string.",
    "st": [
      { "pos": 0, "bit": "b7", "name": "SBU priority version added (PGK: PV or AC feeds the load)" },
      { "pos": 1, "bit": "b6", "name": "Configuration changed" },
      { "pos": 2, "bit": "b5", "name": "SCC firmware updated" },
      { "pos": 3, "bit": "b4", "name": "Load on" },
      { "pos": 4, "bit": "b3", "name": "Battery voltage steady while charging" },
      { "pos": 5, "bit": "b2", "name": "Charging (any source)" },
      { "pos": 6, "bit": "b1", "name": "Solar (SCC) charging" },
      { "pos": 7, "bit": "b0", "name": "AC (utility) charging" }
    ],
    "st2": [
      { "pos": 0, "bit": "b10", "name": "Charging to float" },
      { "pos": 1, "bit": "b9", "name": "Switch on" },
      { "pos": 2, "bit": "b8", "name": "Reserved / dustproof installed" }
    ]
  },

