  "eventTypes": {
    "about": "Event 'type' strings written by the firmware to events/{date}/{id} (d1 section 7.2). The app shows unknown types verbatim. 'clears' names the type whose open alert this type closes (an event of the same type with st=clear also closes it). TEST_ALERT is the type the web app expects for cfg.testAlert (not named in d1). RULE (severity set per rule; the event carries rid, val, thr) and RULE_INVALID come from the owner's alert rules (research/r8-email-alerts.md section 3.6).",
    "types": [
      { "type": "INVERTER_FAULT", "sev": 5, "label": "Inverter fault" },
      { "type": "BATT_CRITICAL", "sev": 5, "label": "Battery critical" },
      { "type": "BATT_LOW", "sev": 4, "label": "Battery low" },
      { "type": "BATT_HIGH", "sev": 4, "label": "Battery voltage high" },
      { "type": "GRID_LOSS", "sev": 4, "label": "Grid lost" },
      { "type": "GRID_RESTORED", "sev": 3, "label": "Grid restored", "clears": "GRID_LOSS" },
      { "type": "GRID_ABNORMAL", "sev": 2, "label": "Grid voltage abnormal" },
      { "type": "OVERLOAD", "sev": 4, "label": "Overload" },
      { "type": "OVER_TEMP", "sev": 4, "label": "Over temperature" },
      { "type": "PV_OVERVOLT", "sev": 4, "label": "PV over-voltage" },
      { "type": "PV_LOW_DAY", "sev": 2, "label": "Low solar today" },
      { "type": "LINK_LOST", "sev": 3, "label": "Inverter link lost" },
      { "type": "LOGGER_REBOOT", "sev": 2, "label": "Logger rebooted" },
      { "type": "LOGGER_OFFLINE", "sev": 1, "label": "Logger was offline" },
      { "type": "QUOTA_GUARD", "sev": 2, "label": "Quota guard active" },
      { "type": "DATA_DROPPED", "sev": 2, "label": "Data dropped" },
      { "type": "BACKLOG_STUCK", "sev": 2, "label": "Upload backlog stuck" },
      { "type": "DAILY_SUMMARY", "sev": 1, "label": "Daily summary" },
