{
  "about": "Metric catalogue for the owner's alert rules (research/r8-email-alerts.md section 4.3). Single source of truth for web/src/alertMetrics.ts (tools/gen_codes.py). The generator checks that firebase/database.rules.json allows exactly these ids, the same energy set and the same value ranges. 'version' is the catalogue version the logger reports as status.acat; a metric with 'since' > status.acat is hidden in the rule editor. Units are the canonical stored units: W, Wh (never kWh), V, A, %, degC, Hz, min, and 0/1 for booleans. 'hyst' is the default hysteresis when a rule has no 'clr': abs = absolute, pct = percent of |value|, the larger wins.",
  "version": 1,
  "groups": [
    { "id": "power", "label": "Power" },
    { "id": "battery", "label": "Battery" },
    { "id": "grid", "label": "Grid" },
    { "id": "energy", "label": "Energy" }
  ],
  "metrics": [
    { "id": "w",      "label": "Load power",                "group": "power",   "unit": "W",   "kind": "num",  "scopes": ["inst"],         "min": -10000, "max": 20000,   "hyst": { "abs": 50, "pct": 5 }, "since": 1 },
    { "id": "pvw",    "label": "Solar power",               "group": "power",   "unit": "W",   "kind": "num",  "scopes": ["inst"],         "min": -10000, "max": 20000,   "hyst": { "abs": 50, "pct": 5 }, "since": 1 },
    { "id": "ld",     "label": "Load % of rating",          "group": "power",   "unit": "%",   "kind": "num",  "scopes": ["inst"],         "min": 0,      "max": 250,     "hyst": { "abs": 2 },            "since": 1 },
    { "id": "ov",     "label": "Output voltage",            "group": "power",   "unit": "V",   "kind": "num",  "scopes": ["inst"],         "min": 0,      "max": 600,     "hyst": { "abs": 5 },            "since": 1 },
    { "id": "pvv",    "label": "Solar voltage",             "group": "power",   "unit": "V",   "kind": "num",  "scopes": ["inst"],         "min": 0,      "max": 600,     "hyst": { "abs": 10 },           "since": 1 },
    { "id": "tmp",    "label": "Inverter temperature",      "group": "power",   "unit": "°C",  "kind": "num",  "scopes": ["inst"],         "min": -20,    "max": 150,     "hyst": { "abs": 3 },            "since": 1 },
    { "id": "soc",    "label": "Battery SOC",               "group": "battery", "unit": "%",   "kind": "num",  "scopes": ["inst"],         "min": 0,      "max": 250,     "hyst": { "abs": 2 },            "since": 1 },
    { "id": "bv",     "label": "Battery voltage",           "group": "battery", "unit": "V",   "kind": "num",  "scopes": ["inst"],         "min": 0,      "max": 600,     "hyst": { "abs": 0.3 },          "since": 1 },
    { "id": "bw",     "label": "Battery net power (+ = charging)", "group": "battery", "unit": "W", "kind": "num", "scopes": ["inst"],   "min": -10000, "max": 20000,   "hyst": { "abs": 50, "pct": 5 }, "since": 1 },
    { "id": "bdw",    "label": "Battery discharge power",   "group": "battery", "unit": "W",   "kind": "num",  "scopes": ["inst"],         "min": -10000, "max": 20000,   "hyst": { "abs": 50, "pct": 5 }, "since": 1 },
    { "id": "bdi",    "label": "Battery discharge current", "group": "battery", "unit": "A",   "kind": "num",  "scopes": ["inst"],         "min": 0,      "max": 300,     "hyst": { "abs": 2 },            "since": 1 },
    { "id": "onbat",  "label": "On battery",                "group": "battery", "unit": "",    "kind": "bool", "scopes": ["inst"],         "min": 0,      "max": 1,       "since": 1 },
    { "id": "gw",     "label": "Grid import power",         "group": "grid",    "unit": "W",   "kind": "num",  "scopes": ["inst"],         "min": -10000, "max": 20000,   "hyst": { "abs": 50, "pct": 5 }, "est": true, "since": 1 },
    { "id": "gv",     "label": "Grid voltage",              "group": "grid",    "unit": "V",   "kind": "num",  "scopes": ["inst"],         "min": 0,      "max": 600,     "hyst": { "abs": 5 },            "since": 1 },
    { "id": "gf",     "label": "Grid frequency",            "group": "grid",    "unit": "Hz",  "kind": "num",  "scopes": ["inst"],         "min": 40,     "max": 70,      "hyst": { "abs": 0.3 },          "since": 1 },
    { "id": "nogrid", "label": "Grid absent",               "group": "grid",    "unit": "",    "kind": "bool", "scopes": ["inst"],         "min": 0,      "max": 1,       "since": 1 },
    { "id": "eld",    "label": "Load energy",               "group": "energy",  "unit": "Wh",  "kind": "num",  "scopes": ["day", "month"], "min": 0,      "max": 5000000, "since": 1 },
    { "id": "egr",    "label": "Grid energy",               "group": "energy",  "unit": "Wh",  "kind": "num",  "scopes": ["day", "month"], "min": 0,      "max": 5000000, "est": true, "since": 1 },
    { "id": "epv",    "label": "Solar energy",              "group": "energy",  "unit": "Wh",  "kind": "num",  "scopes": ["day", "month"], "min": 0,      "max": 5000000, "since": 1 },
    { "id": "edis",   "label": "Battery discharged",        "group": "energy",  "unit": "Wh",  "kind": "num",  "scopes": ["day", "month"], "min": 0,      "max": 5000000, "since": 1 },
    { "id": "ech",    "label": "Battery charged",           "group": "energy",  "unit": "Wh",  "kind": "num",  "scopes": ["day", "month"], "min": 0,      "max": 5000000, "since": 1 },
    { "id": "gout",   "label": "Grid outage time",          "group": "energy",  "unit": "min", "kind": "num",  "scopes": ["day", "month"], "min": 0,      "max": 44640,   "since": 1 }
  ]
}
